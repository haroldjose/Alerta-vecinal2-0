{
  "info": {
    "name": "Alerta Vecinal - Pruebas de API de IA (Hugging Face y Cloud Functions)",
    "description": "Pruebas de contrato (estado, formato, latencia) y de efectividad puntual de los tres modelos de Hugging Face que usa el backend, más pruebas de autenticación y validación de las Cloud Functions. Variables: hf_token (token de Hugging Face), id_token (token de sesión de Firebase de un usuario de prueba).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "hf_base",
      "value": "https://router.huggingface.co/hf-inference/models"
    },
    {
      "key": "hf_token",
      "value": ""
    },
    {
      "key": "functions_base",
      "value": "https://us-central1-alerta-vecinal-297eb.cloudfunctions.net"
    },
    {
      "key": "id_token",
      "value": ""
    },
    {
      "key": "firebase_api_key",
      "value": ""
    },
    {
      "key": "test_email",
      "value": ""
    },
    {
      "key": "test_password",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Firebase: obtener id_token (ejecutar primero)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('La clave web (firebase_api_key) se resolvió y empieza con AIza', () => pm.expect(pm.variables.replaceIn('{{firebase_api_key}}') || '').to.match(/^AIza/));",
              "pm.test('Inicio de sesión correcto (HTTP 200)', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Devuelve un idToken', () => pm.expect(body.idToken).to.be.a('string').and.to.have.length.above(100));",
              "if (body.idToken) { pm.collectionVariables.set('id_token', body.idToken); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\",\n  \"returnSecureToken\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://identitytoolkit.googleapis.com/v1/accounts:signInWithPassword?key={{firebase_api_key}}",
          "host": [
            "identitytoolkit",
            "googleapis",
            "com"
          ],
          "path": [
            "v1",
            "accounts:signInWithPassword"
          ],
          "protocol": "https",
          "query": [
            {
              "key": "key",
              "value": "{{firebase_api_key}}"
            }
          ]
        },
        "description": "Inicia sesión con un usuario de prueba y guarda el idToken en la variable id_token. firebase_api_key es la clave web del proyecto (no es el token). El token dura una hora."
      },
      "response": []
    },
    {
      "name": "1. HF toxicidad - texto ofensivo en español",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Tiempo de respuesta menor a 5000 ms (un arranque en frío puede superarlo)', () => pm.expect(pm.response.responseTime).to.be.below(5000));",
              "pm.test('Respuesta en formato JSON', () => pm.expect(pm.response.headers.get('Content-Type') || '').to.include('json'));",
              "const body = pm.response.json();",
              "const list = Array.isArray(body[0]) ? body[0] : body;",
              "pm.test('La respuesta es una lista de etiquetas con puntaje entre 0 y 1', () => {",
              "  pm.expect(list).to.be.an('array').that.is.not.empty;",
              "  list.forEach(x => { pm.expect(x).to.have.property('label'); pm.expect(x.score).to.be.within(0, 1); });",
              "});",
              "pm.test('Incluye las etiquetas toxic y neutral', () => pm.expect(list.map(x => x.label)).to.include.members(['toxic', 'neutral']));",
              "const toxicItem = Array.isArray(list) ? list.find(x => x.label === 'toxic') : null;",
              "const toxic = toxicItem ? toxicItem.score : null;",
              "console.log('Puntaje toxic = ' + toxic);",
              "pm.test('Efectividad: puntaje toxic >= 0.75 (umbral de la app). Puede fallar: el modelo se entrenó con textos en inglés', () => pm.expect(toxic).to.be.at.least(0.75));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{hf_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"inputs\": \"El alcalde es un idiota y un inútil, no hace nada por el barrio.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{hf_base}}/s-nlp/roberta_toxicity_classifier",
          "host": [
            "{{hf_base}}"
          ],
          "path": [
            "s-nlp",
            "roberta_toxicity_classifier"
          ]
        },
        "description": "Modelo s-nlp/roberta_toxicity_classifier (entrenado con comentarios en inglés)."
      },
      "response": []
    },
    {
      "name": "2. HF toxicidad - texto legítimo",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Tiempo de respuesta menor a 5000 ms (un arranque en frío puede superarlo)', () => pm.expect(pm.response.responseTime).to.be.below(5000));",
              "pm.test('Respuesta en formato JSON', () => pm.expect(pm.response.headers.get('Content-Type') || '').to.include('json'));",
              "const body = pm.response.json();",
              "const list = Array.isArray(body[0]) ? body[0] : body;",
              "pm.test('La respuesta es una lista de etiquetas con puntaje entre 0 y 1', () => {",
              "  pm.expect(list).to.be.an('array').that.is.not.empty;",
              "  list.forEach(x => { pm.expect(x).to.have.property('label'); pm.expect(x.score).to.be.within(0, 1); });",
              "});",
              "pm.test('Incluye las etiquetas toxic y neutral', () => pm.expect(list.map(x => x.label)).to.include.members(['toxic', 'neutral']));",
              "const toxicItem = Array.isArray(list) ? list.find(x => x.label === 'toxic') : null;",
              "const toxic = toxicItem ? toxicItem.score : null;",
              "console.log('Puntaje toxic = ' + toxic);",
              "pm.test('Efectividad: puntaje toxic < 0.75 (texto legítimo no se bloquea)', () => pm.expect(toxic).to.be.below(0.75));"
            ]
          }
        }
