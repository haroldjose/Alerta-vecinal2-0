    {
      "name": "3. HF zero-shot - tipo de problema",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Tiempo de respuesta menor a 5000 ms (un arranque en frío puede superarlo)', () => pm.expect(pm.response.responseTime).to.be.below(5000));",
              "pm.test('Respuesta en formato JSON', () => pm.expect(pm.response.headers.get('Content-Type') || '').to.include('json'));",
              "const body = pm.response.json();",
              "pm.test('Devuelve 4 etiquetas y 4 puntajes', () => { pm.expect(body.labels).to.have.lengthOf(4); pm.expect(body.scores).to.have.lengthOf(4); });",
              "pm.test('Los puntajes suman 1 (±0.01)', () => pm.expect(body.scores.reduce((a, b) => a + b, 0)).to.be.closeTo(1, 0.01));",
              "console.log('Etiqueta principal = ' + (body.labels || [])[0]);",
              "pm.test('Efectividad: la etiqueta principal es servicios básicos e infraestructura', () => pm.expect(body.labels[0]).to.eql('servicios básicos e infraestructura'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{hf_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"inputs\": \"Hace tres días no tenemos agua potable en toda la zona sur del barrio.\",\n  \"parameters\": {\n    \"candidate_labels\": [\n      \"inseguridad y delincuencia\",\n      \"servicios básicos e infraestructura\",\n      \"contaminación y medio ambiente\",\n      \"convivencia vecinal\"\n    ],\n    \"multi_label\": false\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{hf_base}}/joeddav/xlm-roberta-large-xnli",
          "host": [
            "{{hf_base}}"
          ],
          "path": [
            "joeddav",
            "xlm-roberta-large-xnli"
          ]
        },
        "description": "Modelo joeddav/xlm-roberta-large-xnli (multilingüe, incluye español)."
      },
      "response": []
    },
    {
      "name": "4. HF similitud - par duplicado y par distinto",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Código HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Tiempo de respuesta menor a 5000 ms (un arranque en frío puede superarlo)', () => pm.expect(pm.response.responseTime).to.be.below(5000));",
              "pm.test('Respuesta en formato JSON', () => pm.expect(pm.response.headers.get('Content-Type') || '').to.include('json'));",
              "const s = pm.response.json();",
              "pm.test('Devuelve un puntaje por cada frase', () => { pm.expect(s).to.be.an('array').with.lengthOf(2); s.forEach(x => pm.expect(x).to.be.a('number')); });",
              "console.log('Similitud duplicado = ' + s[0] + ' / distinto = ' + s[1]);",
              "pm.test('Efectividad: el par duplicado supera el umbral 0.70', () => pm.expect(s[0]).to.be.at.least(0.70));",
              "pm.test('Efectividad: el par distinto queda bajo el umbral 0.70', () => pm.expect(s[1]).to.be.below(0.70));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{hf_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"inputs\": {\n    \"source_sentence\": \"Rompieron la cortina de la tienda de la esquina para robar\",\n    \"sentences\": [\n      \"Intentaron robar en el negocio de la esquina, cortaron la cortina pero no pudieron entrar\",\n      \"Hace tres días no tenemos agua potable en la zona\"\n    ]\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{hf_base}}/sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2",
          "host": [
