        "body": {
          "mode": "raw",
          "raw": "{\n  \"inputs\": \"Hay un bache enorme en la calle principal que daña los autos.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{hf_base}}/s-nlp/roberta_toxicity_classifier",
          "host": [
            "{{hf_base}}"
          ],
          "path": [
            "s-nlp",
            "roberta_toxicity_classifier"
          ]
